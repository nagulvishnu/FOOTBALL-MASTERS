# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Neon:   use the pooled connection string from the Neon dashboard, e.g.
#         postgresql://USER:PASSWORD@ep-...-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: max pg pool connections per Node process (default 10). Keep modest
# on small Render instances / Neon pooled endpoints.
# PG_POOL_MAX=10

# Set to 1 ONLY when testing a production build over plain http://localhost.
# NEVER set this on Render/production: session cookies are always Secure in
# NODE_ENV=production and this flag is ignored there.
# COOKIE_INSECURE=1
